<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yang Agent Settings" Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="15" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LangLabel" Grid.Row="0" Text="Language / 语言" Margin="0,5,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="LanguageCombo" Grid.Row="1" Margin="0,0,0,15">
            <ComboBoxItem Content="中文"/>
            <ComboBoxItem Content="English"/>
        </ComboBox>

        <TextBlock x:Name="ThemeLabel" Grid.Row="2" Text="Theme / 主题" Margin="0,5,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="ThemeCombo" Grid.Row="3" Margin="0,0,0,15" SelectionChanged="theme_changed">
            <ComboBoxItem Content="Light Theme"/>
            <ComboBoxItem Content="Dark Theme"/>
        </ComboBox>

        <TextBlock x:Name="NickLabel" Grid.Row="4" Text="Nickname / 简称" Margin="0,5,0,5" FontWeight="Bold"/>
        <TextBox x:Name="NicknameBox" Grid.Row="5" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="AvatarLabel" Grid.Row="6" Text="Avatar Path / 头像路径" Margin="0,5,0,5" FontWeight="Bold"/>
        <Grid Grid.Row="7" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AvatarBox" Grid.Column="0" Margin="0,0,8,0" Height="25" VerticalContentAlignment="Center"/>
            <Button x:Name="BrowseAvatarBtn" Grid.Column="1" Content="Browse" Height="25" Click="browse_avatar_click" Cursor="Hand"/>
        </Grid>

        <TextBlock x:Name="AboutText" Grid.Row="8" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7">
            Yang Agent Revit
            &#x0a;Version 1.0.0
            &#x0a;Developed by Yang
            &#x0a;Tool: Codex
            &#x0a;Update: https://github.com/5788324/Yang-Agent_Revit
        </TextBlock>

        <Button x:Name="SaveBtn" Grid.Row="9" Content="Save / 保存" Height="35" Click="save_click" Cursor="Hand"/>
    </Grid>
</Window>
