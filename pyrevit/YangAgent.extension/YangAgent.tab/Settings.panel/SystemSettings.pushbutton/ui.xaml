<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yang Agent Settings" Height="720" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <DockPanel Margin="15" x:Name="MainGrid">
        <Button x:Name="SaveBtn" DockPanel.Dock="Bottom" Content="Save / 保存" Height="35" Click="save_click" Cursor="Hand" Margin="0,10,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LangLabel" Text="Language / 语言" Margin="0,5,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="LanguageCombo" Margin="0,0,0,15">
                    <ComboBoxItem Content="中文"/>
                    <ComboBoxItem Content="English"/>
                </ComboBox>

                <TextBlock x:Name="ThemeLabel" Text="Theme / 主题" Margin="0,5,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="ThemeCombo" Margin="0,0,0,15" SelectionChanged="theme_changed">
                    <ComboBoxItem Content="Light Theme"/>
                    <ComboBoxItem Content="Dark Theme"/>
                </ComboBox>

                <TextBlock x:Name="NickLabel" Text="Nickname / 简称" Margin="0,5,0,5" FontWeight="Bold"/>
                <TextBox x:Name="NicknameBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="AvatarLabel" Text="Avatar Path / 头像路径" Margin="0,5,0,5" FontWeight="Bold"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AvatarBox" Grid.Column="0" Margin="0,0,8,0" Height="25" VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseAvatarBtn" Grid.Column="1" Content="Browse" Height="25" Click="browse_avatar_click" Cursor="Hand"/>
                </Grid>

                <TextBlock x:Name="PreferencesLabel" Text="Agent Preferences / AI 工作习惯" Margin="0,10,0,5" FontWeight="Bold"/>
                <TextBlock x:Name="PreferencesHelp" Text="These preferences are local only and will be included in AI review prompts." TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>

                <TextBlock x:Name="RevitVersionsLabel" Text="Revit Versions / 常用 Revit 版本" Margin="0,5,0,3"/>
                <TextBox x:Name="RevitVersionsBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="WorkflowLabel" Text="Preferred Workflow / 默认工作流" Margin="0,5,0,3"/>
                <TextBox x:Name="WorkflowBox" Margin="0,0,0,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ReviewFocusLabel" Text="Review Focus / AI 分析重点" Margin="0,5,0,3"/>
                <TextBox x:Name="ReviewFocusBox" Margin="0,0,0,8" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="SafetyNotesLabel" Text="Safety Notes / 安全偏好" Margin="0,5,0,3"/>
                <TextBox x:Name="SafetyNotesBox" Margin="0,0,0,15" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="ViewRulesLabel" Text="View Naming Rules / 视图命名规则" Margin="0,10,0,5" FontWeight="Bold"/>
                <TextBlock x:Name="ViewRulesHelp" Text="Use comma-separated prefixes. Example: FP-, PL-, A-" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"/>

                <TextBlock x:Name="FloorPlanLabel" Text="FloorPlan / 楼层平面" Margin="0,5,0,3"/>
                <TextBox x:Name="FloorPlanPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="CeilingPlanLabel" Text="CeilingPlan / 天花平面" Margin="0,5,0,3"/>
                <TextBox x:Name="CeilingPlanPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="SectionLabel" Text="Section / 剖面" Margin="0,5,0,3"/>
                <TextBox x:Name="SectionPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="ElevationLabel" Text="Elevation / 立面" Margin="0,5,0,3"/>
                <TextBox x:Name="ElevationPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="ThreeDLabel" Text="ThreeD / 三维" Margin="0,5,0,3"/>
                <TextBox x:Name="ThreeDPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="DraftingViewLabel" Text="DraftingView / 详图" Margin="0,5,0,3"/>
                <TextBox x:Name="DraftingViewPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="LegendLabel" Text="Legend / 图例" Margin="0,5,0,3"/>
                <TextBox x:Name="LegendPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="AreaPlanLabel" Text="AreaPlan / 面积平面" Margin="0,5,0,3"/>
                <TextBox x:Name="AreaPlanPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="EngineeringPlanLabel" Text="EngineeringPlan / 工程平面" Margin="0,5,0,3"/>
                <TextBox x:Name="EngineeringPlanPrefixesBox" Margin="0,0,0,8" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="KeywordsLabel" Text="Temporary Keywords / 临时关键词" Margin="0,5,0,3"/>
                <TextBox x:Name="TemporaryKeywordsBox" Margin="0,0,0,15" Height="25" VerticalContentAlignment="Center"/>

                <TextBlock x:Name="AboutText" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7">
                    Yang Agent Revit
                    &#x0a;Version 1.0.0
                    &#x0a;Developed by Yang
                    &#x0a;Tool: Codex
                    &#x0a;Update: https://github.com/5788324/Yang-Agent_Revit
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
